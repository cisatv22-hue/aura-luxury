{
    "name": "aura-luxury/aurashop",
    "description": "AuraShop: tienda en linea AURA LUXURY como extension de Dolibarr",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AuraShop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AuraShop\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.17"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
